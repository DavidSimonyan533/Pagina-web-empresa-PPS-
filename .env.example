# Copia este archivo a .env y cambia los valores. NO subas .env a GitHub.

# Clave para firmar sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos PostgreSQL (contenedor "db")
POSTGRES_USER=davem
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=davem_cyber
DB_HOST=db

# En local (http) debe ser false. Con HTTPS ponlo en true.
COOKIE_SECURE=false
